# =============================================================================
# Copy the backend block into backend/.env
# Copy the frontend block into frontend/.env
# Never commit real values.
# =============================================================================

# -----------------------------------------------------------------------------
# Frontend (Vite, public — these are exposed to the browser)
# File: frontend/.env
# -----------------------------------------------------------------------------
VITE_API_URL=http://localhost:8000
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# -----------------------------------------------------------------------------
# Backend (Django, private)
# File: backend/.env
# -----------------------------------------------------------------------------
DEBUG=True
DJANGO_SECRET_KEY=replace-me-with-a-long-random-string
ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:5173

# -----------------------------------------------------------------------------
# Supabase — PostgreSQL (backend)
# Use the URI from Supabase → Project Settings → Database.
# The app falls back to local SQLite only when DEBUG=True and this is empty.
# Production must set DATABASE_URL.
# Use DATABASE_SSLMODE=disable for a local Postgres without TLS.
# -----------------------------------------------------------------------------
DATABASE_URL=
DATABASE_SSLMODE=require

# -----------------------------------------------------------------------------
# Supabase — Auth (backend)
# Set SUPABASE_URL for JWKS verification (newer projects, ES256/RS256).
# Set SUPABASE_JWT_SECRET for HS256 verification (legacy JWT secret).
# At least one is required for authenticated API requests.
# SUPABASE_SERVICE_ROLE_KEY is optional and only for later Storage admin work.
# Never put the service role key in frontend env.
# -----------------------------------------------------------------------------
SUPABASE_URL=
SUPABASE_JWT_SECRET=
SUPABASE_SERVICE_ROLE_KEY=

# -----------------------------------------------------------------------------
# Gemini (backend only, optional at startup)
# -----------------------------------------------------------------------------
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GEMINI_FALLBACK_MODEL=gemini-3.5-flash

# -----------------------------------------------------------------------------
# n8n (backend only, optional at startup)
# -----------------------------------------------------------------------------
N8N_WEBHOOK_URL=
