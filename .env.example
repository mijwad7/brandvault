# =============================================================================
# Copy the frontend block into frontend/.env (local) or Vercel env (production).
# Copy the backend block into backend/.env (local) or Railway variables (production).
# Never commit real values. This file has placeholders only.
#
# Vercel (build time, public, baked into the JS bundle):
#   VITE_API_URL, VITE_SUPABASE_URL, VITE_SUPABASE_ANON_KEY, VITE_STORAGE_BUCKET
# Railway (runtime, private):
#   everything in the Backend and Supabase/Gemini sections below
# =============================================================================

# -----------------------------------------------------------------------------
# Frontend — Vercel project, Root Directory = frontend
# Public. Exposed to the browser. Set these in Vercel before the production build.
# Local file: frontend/.env
# -----------------------------------------------------------------------------
VITE_API_URL=http://localhost:8000
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# Public bucket name. Must match SUPABASE_STORAGE_BUCKET. Not a secret.
VITE_STORAGE_BUCKET=assets

# -----------------------------------------------------------------------------
# Backend — Railway service, Root Directory = backend
# Private. Local file: backend/.env
# Production: DEBUG=False, and set DJANGO_SECRET_KEY, DATABASE_URL, ALLOWED_HOSTS.
# -----------------------------------------------------------------------------
DEBUG=True
DJANGO_SECRET_KEY=replace-me-with-a-long-random-string
ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:5173
# Comma-separated https origins. Production: the Vercel site origin.
# Example: https://brandvault.vercel.app
CSRF_TRUSTED_ORIGINS=
# Railway sets X-Forwarded-Proto. Defaults on when DEBUG=False. Set false to disable.
# USE_X_FORWARDED_PROTO=true

# -----------------------------------------------------------------------------
# Supabase — PostgreSQL (backend)
# Use the URI from Supabase → Project Settings → Database.
# The app falls back to local SQLite only when DEBUG=True and this is empty.
# Production (Railway) must set DATABASE_URL.
# Use the Supabase session pooler URI (host pooler.supabase.com, port 5432).
# Connections close after each request (DB_CONN_MAX_AGE defaults to 0) so the
# 15-client session pool is not held open. Leave DB_CONN_MAX_AGE unset.
# Use DATABASE_SSLMODE=disable for a local Postgres without TLS.
# -----------------------------------------------------------------------------
DATABASE_URL=
DATABASE_SSLMODE=require

# -----------------------------------------------------------------------------
# Supabase — Auth (backend)
# Set SUPABASE_URL for JWKS verification (newer projects, ES256/RS256).
# Leave SUPABASE_JWT_SECRET empty in production so tokens verify via JWKS.
# Set SUPABASE_JWT_SECRET only for HS256 verification (legacy JWT secret).
# At least one of SUPABASE_URL or SUPABASE_JWT_SECRET is required for authenticated API requests.
# SUPABASE_SERVICE_ROLE_KEY is not used for uploads. The browser uploads with the
# user JWT. Keep the service role key out of Vite.
# SUPABASE_STORAGE_BUCKET must match VITE_STORAGE_BUCKET and the bucket you create.
# -----------------------------------------------------------------------------
SUPABASE_URL=
SUPABASE_JWT_SECRET=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=assets

# -----------------------------------------------------------------------------
# Gemini (backend only, optional at startup)
# -----------------------------------------------------------------------------
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GEMINI_FALLBACK_MODEL=gemini-3.5-flash

# -----------------------------------------------------------------------------
# n8n (backend only, optional at startup)
# -----------------------------------------------------------------------------
N8N_WEBHOOK_URL=
